page 120 (
    name: Shipments
    alias: SHIPMENTS
    title: Shipments
    pageGroup: @outbound
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Shipment/manifest records (FR-04). Use Ship Order below once an order is PACKED -- this closes the order out of the warehouse and creates the shipment record shown in the report.
    }

    region breadcrumb (
        name: Shipments
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region SHIPMENTS_REPORT (
        name: Shipments
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    s.shipment_id,
                    o.order_number,
                    c.customer_name,
                    s.carrier,
                    s.tracking_number,
                    s.ship_date,
                    s.status,
                    w.warehouse_code
                from shipment s
                join outbound_order o on o.order_id = s.order_id
                join customer c on c.customer_id = o.customer_id
                left join warehouse w on w.warehouse_id = s.ship_from_warehouse_id
                order by s.shipment_id desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No shipments found.
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        column SHIPMENT_ID (
            type: hidden
            heading {
                heading: Shipment Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column ORDER_NUMBER (
            type: plainText
            heading {
                heading: Order Number
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column CARRIER (
            type: plainText
            heading {
                heading: Carrier
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column TRACKING_NUMBER (
            type: plainText
            heading {
                heading: Tracking Number
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column SHIP_DATE (
            type: plainText
            heading {
                heading: Ship Date
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                dataType: DATE
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column WAREHOUSE_CODE (
            type: plainText
            heading {
                heading: Ship From Warehouse
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )
    )

    region SHIP_ORDER (
        name: Ship Order
        type: staticContent
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P120_SHIP_ORDER_ID (
        type: selectList
        label {
            label: Order (packed)
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select order_number as d, order_id as r
                  from outbound_order
                 where status = 'PACKED'
                 order by order_id desc
                ```
        }
        layout {
            sequence: 10
            region: @SHIP_ORDER
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Only orders in PACKED status are listed. Shipping removes the packed stock from the shipping staging location and closes the order.
        }
    )

    pageItem P120_CARRIER (
        type: textField
        label {
            label: Carrier
            alignment: left
        }
        layout {
            sequence: 20
            region: @SHIP_ORDER
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 60
        }
        help {
            helpText: Optional carrier name for this shipment (e.g. the freight/parcel company).
        }
    )

    pageItem P120_TRACKING_NUMBER (
        type: textField
        label {
            label: Tracking Number
            alignment: left
        }
        layout {
            sequence: 30
            region: @SHIP_ORDER
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 60
        }
        help {
            helpText: Optional carrier tracking number for this shipment.
        }
    )

    region SHIP_BUTTONS (
        name: Ship Buttons
        type: staticContent
        layout {
            sequence: 31
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button SHIP_ORDER_BTN (
        buttonName: SHIP_ORDER_BTN
        label: Ship Order
        layout {
            sequence: 10
            region: @SHIP_BUTTONS
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Ship this order? This removes the packed stock from the shipping staging location and closes the order. This cannot be undone.
            style: warning
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P120_SHIP_ORDER_ID
        }
    )

    process ship-order-proc (
        name: Ship Order
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_shipment_id shipment.shipment_id%type;
                begin
                    l_shipment_id := pkg_shipment.ship_order(
                        p_order_id       => :P120_SHIP_ORDER_ID,
                        p_carrier        => :P120_CARRIER,
                        p_tracking_number => :P120_TRACKING_NUMBER
                    );
                    :P120_SHIP_ORDER_ID := null;
                    :P120_CARRIER := null;
                    :P120_TRACKING_NUMBER := null;
                exception
                    when others then
                        apex_error.add_error(
                            p_message          => sqlerrm,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Order shipped successfully.
        }
        serverSideCondition {
            whenButtonPressed: @SHIP_ORDER_BTN
        }
    )

)
