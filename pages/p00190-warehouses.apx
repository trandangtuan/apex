page 190 (
    name: Warehouses
    alias: WAREHOUSES
    title: Warehouses
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Browse and maintain warehouse sites (FR-01). Referenced by Locations, Inbound Receipts and Outbound Orders.
    }

    region breadcrumb (
        name: Warehouses
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--compactTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region WAREHOUSES_GRID (
        name: Warehouses
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    warehouse_id,
                    warehouse_code,
                    warehouse_name,
                    address,
                    is_active
                from warehouse
                order by warehouse_code
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No warehouses found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @WAREHOUSE_CODE
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @WAREHOUSE_NAME
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @ADDRESS
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @IS_ACTIVE
                layout {
                    sequence: 4
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column WAREHOUSE_ID (
            type: hidden
            layout {
                sequence: 15
            }
            source {
                databaseColumn: WAREHOUSE_ID
                dataType: number
                primaryKey: true
            }
        )

        column WAREHOUSE_CODE (
            type: textField
            heading {
                heading: Warehouse Code
            }
            layout {
                sequence: 20
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: WAREHOUSE_CODE
                dataType: varchar2
            }
        )

        column WAREHOUSE_NAME (
            type: textField
            heading {
                heading: Warehouse Name
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: WAREHOUSE_NAME
                dataType: varchar2
            }
        )

        column ADDRESS (
            type: textField
            heading {
                heading: Address
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: ADDRESS
                dataType: varchar2
            }
        )

        column IS_ACTIVE (
            type: checkbox
            heading {
                heading: Active
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IS_ACTIVE
                dataType: varchar2
            }
        )
    )

    process WAREHOUSES_GRID_ARP (
        name: Warehouses - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @WAREHOUSES_GRID
        execution {
            sequence: 10
        }
    )

)
