page 60 (
    name: Inbound Receipts
    alias: INBOUND-RECEIPTS
    title: Inbound Receipts
    pageGroup: @inbound
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Inbound receipt headers (FR-02). Create a receipt here, then add/receive lines on the Inbound Receipt Lines page. Supplier and Warehouse are selected from active master lists. Business logic (receive, putaway, complete) runs through PKG_INBOUND, not direct edits to STATUS.
    }

    region breadcrumb (
        name: Inbound Receipts
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region INBOUND_RECEIPTS_GRID (
        name: Inbound Receipts
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    receipt_id,
                    supplier_id,
                    po_reference,
                    warehouse_id,
                    expected_date,
                    status,
                    received_by
                from inbound_receipt
                order by receipt_id desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No inbound receipts found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @RECEIPT_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @SUPPLIER_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @PO_REFERENCE
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @WAREHOUSE_ID
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @EXPECTED_DATE
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @STATUS
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @RECEIVED_BY
                layout {
                    sequence: 7
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column RECEIPT_ID (
            type: numberField
            heading {
                heading: Receipt Id
            }
            layout {
                sequence: 20
            }
            source {
                databaseColumn: RECEIPT_ID
                dataType: number
                primaryKey: true
            }
        )

        column SUPPLIER_ID (
            type: selectList
            heading {
                heading: Supplier
            }
            layout {
                sequence: 30
            }
            lov {
                type: sharedComponent
                lov: @supplier-active
            }
            source {
                databaseColumn: SUPPLIER_ID
                dataType: number
            }
        )

        column PO_REFERENCE (
            type: textField
            heading {
                heading: PO Reference
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 40
            }
            source {
                databaseColumn: PO_REFERENCE
                dataType: varchar2
            }
        )

        column WAREHOUSE_ID (
            type: selectList
            heading {
                heading: Warehouse
            }
            layout {
                sequence: 50
            }
            lov {
                type: sharedComponent
                lov: @warehouse-active
            }
            source {
                databaseColumn: WAREHOUSE_ID
                dataType: number
            }
        )

        column EXPECTED_DATE (
            type: datePicker
            heading {
                heading: Expected Date
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: EXPECTED_DATE
                dataType: date
            }
        )

        column STATUS (
            type: selectList
            heading {
                heading: Status
            }
            layout {
                sequence: 70
            }
            lov {
                type: staticValues
                staticValues: STATIC:Expected;EXPECTED,Receiving;RECEIVING,Completed;COMPLETED,Closed;CLOSED
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
        )

        column RECEIVED_BY (
            type: textField
            heading {
                heading: Received By
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 60
            }
            source {
                databaseColumn: RECEIVED_BY
                dataType: varchar2
            }
        )
    )

    process INBOUND_RECEIPTS_GRID_ARP (
        name: Inbound Receipts - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @INBOUND_RECEIPTS_GRID
        execution {
            sequence: 10
        }
    )

)
