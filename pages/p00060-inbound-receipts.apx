page 60 (
    name: Inbound Receipts
    alias: INBOUND-RECEIPTS
    title: Inbound Receipts
    pageGroup: @inventory
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Inbound receipt headers (FR-02). Click a row's detail icon to open the receipt, manage its lines, and receive/putaway/complete it. Use New Receipt to create one.
    }

    region breadcrumb (
        name: Inbound Receipts
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--compactTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region INBOUND_RECEIPTS_IR (
        name: Inbound Receipts
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    r.receipt_id,
                    s.supplier_name,
                    r.po_reference,
                    w.warehouse_name,
                    r.expected_date,
                    r.status,
                    r.received_by,
                    (select count(*) from inbound_receipt_line l where l.receipt_id = r.receipt_id) as line_count
                from inbound_receipt r
                join warehouse w on w.warehouse_id = r.warehouse_id
                left join supplier s on s.supplier_id = r.supplier_id
                order by r.receipt_id desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 61
                items: {
                    P61_RECEIPT_ID: #RECEIPT_ID#
                }
                clearCache: 61
            }
            linkIcon: <span role="img" aria-label="Detail" class="fa fa-search-plus" title="View Detail"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No inbound receipts found.
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        column RECEIPT_ID (
            type: hidden
            heading {
                heading: Receipt Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column SUPPLIER_NAME (
            type: plainText
            heading {
                heading: Supplier
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column PO_REFERENCE (
            type: plainText
            heading {
                heading: PO Reference
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column WAREHOUSE_NAME (
            type: plainText
            heading {
                heading: Warehouse
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column EXPECTED_DATE (
            type: plainText
            heading {
                heading: Expected Date
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                dataType: DATE
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column RECEIVED_BY (
            type: plainText
            heading {
                heading: Received By
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column LINE_COUNT (
            type: plainText
            heading {
                heading: Lines
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )
    )

    button NEW_RECEIPT (
        buttonName: NEW_RECEIPT
        label: New Receipt
        layout {
            sequence: 10
            region: @INBOUND_RECEIPTS_IR
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
            hot: true
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 61
                clearCache: 61
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
