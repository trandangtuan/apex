page 71 (
    name: Inbound Receipt Line Form
    alias: INBOUND-RECEIPT-LINE-FORM
    title: Inbound Receipt Line Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Create or update one inbound receipt line (FR-02). Receipt, Item, Lot and Putaway Location are all selected from master lists. Prefer driving RECEIVED_QTY/PUTAWAY_LOCATION_ID/STATUS through PKG_INBOUND.receive_line / putaway_line rather than editing them here directly.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Inbound Receipt Line Form
        type: form
        source {
            location: localDatabase
            tableName: INBOUND_RECEIPT_LINE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P71_LINE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: LINE_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P71_SUCCESS_MESSAGE (
        type: hidden
        layout {
            sequence: 11
            region: @form
            slot: regionBody
        }
    )

    pageItem P71_RECEIPT_ID (
        type: selectList
        label {
            label: Receipt
        }
        lov {
            type: sharedComponent
            lov: @inbound-receipt-any
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: RECEIPT_ID
            dataType: number
        }
        help {
            helpText: Receipt header this line belongs to.
        }
    )

    pageItem P71_ITEM_ID (
        type: selectList
        label {
            label: Item
        }
        lov {
            type: sharedComponent
            lov: @item-active
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ITEM_ID
            dataType: number
        }
        help {
            helpText: Item expected on this line, selected from the active Item master list.
        }
    )

    pageItem P71_LOT_ID (
        type: selectList
        label {
            label: Lot
        }
        lov {
            type: sharedComponent
            lov: @lot-any
            displayNullValue: true
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: LOT_ID
            dataType: number
        }
        help {
            helpText: Optional lot/batch, when known ahead of receiving.
        }
    )

    pageItem P71_EXPECTED_QTY (
        type: numberField
        label {
            label: Expected Qty
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: EXPECTED_QTY
            dataType: number
        }
        help {
            helpText: Quantity expected to be received on this line.
        }
    )

    pageItem P71_RECEIVED_QTY (
        type: numberField
        label {
            label: Received Qty
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 0
        }
        source {
            formRegion: @form
            column: RECEIVED_QTY
            dataType: number
        }
        help {
            helpText: Normally maintained by PKG_INBOUND.receive_line; edit here only to correct a mistake.
        }
    )

    pageItem P71_PUTAWAY_LOCATION_ID (
        type: selectList
        label {
            label: Putaway Location
        }
        lov {
            type: sharedComponent
            lov: @location-active
            displayNullValue: true
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: PUTAWAY_LOCATION_ID
            dataType: number
        }
        help {
            helpText: Normally set by PKG_INBOUND.putaway_line; edit here only to correct a mistake.
        }
    )

    pageItem P71_STATUS (
        type: selectList
        label {
            label: Status
        }
        lov {
            type: staticValues
            staticValues: STATIC:Pending;PENDING,Received;RECEIVED,Putaway;PUTAWAY,Short;SHORT,Cancelled;CANCELLED
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: PENDING
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: STATUS
            dataType: varchar2
        }
        help {
            helpText: Normally advanced automatically by PKG_INBOUND; edit here only to correct a mistake.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P71_LINE_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_LINE_ID
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_LINE_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process initialize-form-form (
        name: Initialize form Form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process set-success-message-form (
        name: Set Success Message
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P71_SUCCESS_MESSAGE :=
                    case :REQUEST
                        when 'CREATE' then 'Inbound receipt line was created successfully.'
                        when 'APPLY-CHANGES' then 'Inbound receipt line was updated successfully.'
                        when 'DELETE' then 'Inbound receipt line was deleted successfully.'
                        else null
                    end;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process process-form-form (
        name: Process form Form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &P71_SUCCESS_MESSAGE.
        }
    )

)
