page 11 (
    name: Item Form
    alias: ITEM-FORM
    title: Item Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Create or update one item / SKU record (FR-01). UOM is selected from the active UOM master list.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Item Form
        type: form
        source {
            location: localDatabase
            tableName: ITEM
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P11_ITEM_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: ITEM_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_SUCCESS_MESSAGE (
        type: hidden
        layout {
            sequence: 11
            region: @form
            slot: regionBody
        }
    )

    pageItem P11_ITEM_CODE (
        type: textField
        label {
            label: Item Code
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 30
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ITEM_CODE
            dataType: varchar2
        }
        help {
            helpText: Unique SKU code for this item.
        }
    )

    pageItem P11_ITEM_NAME (
        type: textField
        label {
            label: Item Name
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ITEM_NAME
            dataType: varchar2
        }
        help {
            helpText: Descriptive name shown in reports and lookups.
        }
    )

    pageItem P11_DEVICE_CATEGORY (
        type: textField
        label {
            label: Device Category
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 40
            valueRequired: true
        }
        source {
            formRegion: @form
            column: DEVICE_CATEGORY
            dataType: varchar2
        }
        help {
            helpText: One of BIOMETRIC_READER, CHIP_CARD_READER, MONITOR, TV_DISPLAY, TABLET, MOBILE_DEVICE, E_POSTER, SPEAKER, DIGITAL_SIGNATURE_READER, MEDIA_PLAYER, OTHER.
        }
    )

    pageItem P11_UOM (
        type: selectList
        label {
            label: UOM
        }
        lov {
            type: sharedComponent
            lov: @uom-active
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: UOM
            dataType: varchar2
        }
        help {
            helpText: Unit of measure, selected from the active UOM master list.
        }
    )

    pageItem P11_BARCODE_VALUE (
        type: textField
        label {
            label: Barcode
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 64
        }
        source {
            formRegion: @form
            column: BARCODE_VALUE
            dataType: varchar2
        }
        help {
            helpText: Optional barcode/QR value used for scan lookup.
        }
    )

    pageItem P11_REORDER_POINT (
        type: numberField
        label {
            label: Reorder Point
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: REORDER_POINT
            dataType: number
        }
        help {
            helpText: Quantity threshold that should trigger replenishment.
        }
    )

    pageItem P11_IS_LOT_TRACKED (
        type: selectList
        label {
            label: Lot Tracked
        }
        lov {
            type: staticValues
            staticValues: STATIC:Yes;Y,No;N
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        source {
            formRegion: @form
            column: IS_LOT_TRACKED
            dataType: varchar2
        }
        help {
            helpText: Check if stock of this item is tracked by lot/batch number.
        }
    )

    pageItem P11_IS_ACTIVE (
        type: selectList
        label {
            label: Active
        }
        lov {
            type: staticValues
            staticValues: STATIC:Yes;Y,No;N
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        source {
            formRegion: @form
            column: IS_ACTIVE
            dataType: varchar2
        }
        help {
            helpText: Uncheck to retire this item without deleting its history.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_ITEM_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_ITEM_ID
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_ITEM_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process initialize-form-form (
        name: Initialize form Form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process set-success-message-form (
        name: Set Success Message
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P11_SUCCESS_MESSAGE :=
                    case :REQUEST
                        when 'CREATE' then 'Item was created successfully.'
                        when 'APPLY-CHANGES' then 'Item was updated successfully.'
                        when 'DELETE' then 'Item was deleted successfully.'
                        else null
                    end;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process process-form-form (
        name: Process form Form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &P11_SUCCESS_MESSAGE.
        }
    )

)
