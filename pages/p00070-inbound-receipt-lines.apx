page 70 (
    name: Inbound Receipt Lines
    alias: INBOUND-RECEIPT-LINES
    title: Inbound Receipt Lines
    pageGroup: @inbound
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Inbound receipt lines (FR-02). Select a line and click Edit to open it, or use New Line to plan an expected line. Receipt, Item, Lot and Putaway Location are all selected from master lists. RECEIVED_QTY, PUTAWAY_LOCATION_ID and STATUS are normally maintained by PKG_INBOUND.receive_line / putaway_line, not by direct edit here.
    }

    region breadcrumb (
        name: Inbound Receipt Lines
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Actions
        type: staticContent
        layout {
            sequence: 15
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P70_EDIT_SELECT (
        type: numberField
        label {
            label: Line Id to Edit
        }
        layout {
            sequence: 10
            region: @actions
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Enter the Line Id shown below, then click Edit to open it.
        }
    )

    button edit-line (
        buttonName: EDIT_LINE
        label: Edit
        layout {
            sequence: 20
            region: @actions
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 71
                items: {
                    P71_LINE_ID: &P70_EDIT_SELECT.
                }
                clearCache: 71
            }
        }
    )

    button create-line (
        buttonName: CREATE_LINE
        label: New Line
        layout {
            sequence: 30
            region: @actions
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 71
                clearCache: 71
            }
        }
    )

    region INBOUND_RECEIPT_LINES_REPORT (
        name: Inbound Receipt Lines
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    rl.line_id,
                    rl.receipt_id,
                    i.item_code,
                    lt.lot_number,
                    rl.expected_qty,
                    rl.received_qty,
                    loc.location_code as putaway_location_code,
                    rl.status
                from inbound_receipt_line rl
                join item i on i.item_id = rl.item_id
                left join lot lt on lt.lot_id = rl.lot_id
                left join location loc on loc.location_id = rl.putaway_location_id
                order by rl.receipt_id desc, rl.line_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No inbound receipt lines found.
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        column LINE_ID (
            type: plainText
            heading {
                heading: Line Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column RECEIPT_ID (
            type: plainText
            heading {
                heading: Receipt Id
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
        )

        column ITEM_CODE (
            type: plainText
            heading {
                heading: Item
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column LOT_NUMBER (
            type: plainText
            heading {
                heading: Lot
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column EXPECTED_QTY (
            type: plainText
            heading {
                heading: Expected Qty
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column RECEIVED_QTY (
            type: plainText
            heading {
                heading: Received Qty
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column PUTAWAY_LOCATION_CODE (
            type: plainText
            heading {
                heading: Putaway Location
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )
    )

    dynamicAction refresh-on-edit (
        name: Refresh on Edit
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @INBOUND_RECEIPT_LINES_REPORT
        }

        action refresh-inbound-receipt-lines-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @INBOUND_RECEIPT_LINES_REPORT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

)
