page 70 (
    name: Inbound Receipt Lines
    alias: INBOUND-RECEIPT-LINES
    title: Inbound Receipt Lines
    pageGroup: @inbound
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Inbound receipt lines (FR-02). Receipt, Item, Lot and Putaway Location are selected from master lists. RECEIVED_QTY, PUTAWAY_LOCATION_ID and STATUS are normally maintained by PKG_INBOUND.receive_line / putaway_line, not by direct edit here; this grid is for planning expected lines and reviewing progress.
    }

    region breadcrumb (
        name: Inbound Receipt Lines
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region INBOUND_RECEIPT_LINES_GRID (
        name: Inbound Receipt Lines
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    line_id,
                    receipt_id,
                    item_id,
                    lot_id,
                    expected_qty,
                    received_qty,
                    putaway_location_id,
                    status
                from inbound_receipt_line
                order by receipt_id desc, line_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No inbound receipt lines found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @LINE_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @RECEIPT_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @ITEM_ID
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @LOT_ID
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @EXPECTED_QTY
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @RECEIVED_QTY
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @PUTAWAY_LOCATION_ID
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @STATUS
                layout {
                    sequence: 8
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column LINE_ID (
            type: numberField
            heading {
                heading: Line Id
            }
            layout {
                sequence: 20
            }
            source {
                databaseColumn: LINE_ID
                dataType: number
                primaryKey: true
            }
        )

        column RECEIPT_ID (
            type: selectList
            heading {
                heading: Receipt
            }
            layout {
                sequence: 30
            }
            lov {
                type: sharedComponent
                lov: @inbound-receipt-any
            }
            source {
                databaseColumn: RECEIPT_ID
                dataType: number
            }
        )

        column ITEM_ID (
            type: selectList
            heading {
                heading: Item
            }
            layout {
                sequence: 40
            }
            lov {
                type: sharedComponent
                lov: @item-active
            }
            source {
                databaseColumn: ITEM_ID
                dataType: number
            }
        )

        column LOT_ID (
            type: selectList
            heading {
                heading: Lot
            }
            layout {
                sequence: 50
            }
            lov {
                type: sharedComponent
                lov: @lot-any
                displayExtraValues: true
            }
            source {
                databaseColumn: LOT_ID
                dataType: number
            }
        )

        column EXPECTED_QTY (
            type: numberField
            heading {
                heading: Expected Qty
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: EXPECTED_QTY
                dataType: number
            }
        )

        column RECEIVED_QTY (
            type: numberField
            heading {
                heading: Received Qty
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: RECEIVED_QTY
                dataType: number
            }
        )

        column PUTAWAY_LOCATION_ID (
            type: selectList
            heading {
                heading: Putaway Location
            }
            layout {
                sequence: 80
            }
            lov {
                type: sharedComponent
                lov: @location-active
                displayExtraValues: true
            }
            source {
                databaseColumn: PUTAWAY_LOCATION_ID
                dataType: number
            }
        )

        column STATUS (
            type: selectList
            heading {
                heading: Status
            }
            layout {
                sequence: 90
            }
            lov {
                type: staticValues
                staticValues: STATIC:Pending;PENDING,Received;RECEIVED,Putaway;PUTAWAY,Short;SHORT,Cancelled;CANCELLED
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
        )
    )

    process INBOUND_RECEIPT_LINES_GRID_ARP (
        name: Inbound Receipt Lines - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @INBOUND_RECEIPT_LINES_GRID
        execution {
            sequence: 10
        }
    )

)
