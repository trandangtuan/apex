page 91 (
    name: Outbound Order Detail
    alias: OUTBOUND-ORDER-DETAIL
    title: Outbound Order Detail
    pageGroup: @outbound
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Outbound order header and lines (FR-04). Create or edit the header, then add/edit lines below (item, qty ordered). QTY_ALLOCATED/QTY_PICKED/QTY_SHIPPED and STATUS are maintained by PKG_OUTBOUND/PKG_PICKING, not by direct edit. Lifecycle: RECEIVED (on create) -> Allocate reserves stock and creates pick tasks (PKG_OUTBOUND.allocate_order) -> ALLOCATED -> picking on the Pick Tasks screen moves it through PICKING/PICKED automatically -> Pack Order (PKG_PACKING.pack_order) once every line is PICKED -> Ship Order (PKG_SHIPMENT.ship_order) once packed. Cancel Order (PKG_OUTBOUND.cancel_order) releases any reserved/allocated stock and is available any time before SHIPPED.
    }

    region breadcrumb (
        name: Outbound Order Detail
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region HEADER_FORM (
        name: Order Header
        type: form
        source {
            location: localDatabase
            tableName: OUTBOUND_ORDER
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P91_ORDER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @HEADER_FORM
            slot: regionBody
        }
        source {
            formRegion: @HEADER_FORM
            column: ORDER_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P91_ORDER_NUMBER (
        type: textField
        label {
            label: Order Number
            alignment: left
        }
        layout {
            sequence: 20
            region: @HEADER_FORM
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @HEADER_FORM
            column: ORDER_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Unique order number/reference for this outbound order.
        }
    )

    pageItem P91_CUSTOMER_ID (
        type: selectList
        label {
            label: Customer
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @customer-active
        }
        layout {
            sequence: 30
            region: @HEADER_FORM
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @HEADER_FORM
            column: CUSTOMER_ID
            dataType: number
        }
        help {
            helpText: Customer this order ships to. Only active customers are listed.
        }
    )

    pageItem P91_WAREHOUSE_ID (
        type: selectList
        label {
            label: Warehouse
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @warehouse-active
        }
        layout {
            sequence: 40
            region: @HEADER_FORM
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @HEADER_FORM
            column: WAREHOUSE_ID
            dataType: number
        }
        help {
            helpText: Warehouse this order ships from. Only active warehouses are listed.
        }
    )

    pageItem P91_ORDER_SOURCE (
        type: textField
        label {
            label: Order Source
            alignment: left
        }
        layout {
            sequence: 50
            region: @HEADER_FORM
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @HEADER_FORM
            column: ORDER_SOURCE
            dataType: varchar2
        }
        help {
            helpText: Where this order originated (e.g. web, EDI, manual).
        }
    )

    pageItem P91_ORDER_DATE (
        type: datePicker
        label {
            label: Order Date
            alignment: left
        }
        layout {
            sequence: 60
            region: @HEADER_FORM
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @HEADER_FORM
            column: ORDER_DATE
            dataType: date
        }
        help {
            helpText: Date this order was placed.
        }
    )

    pageItem P91_REQUIRED_SHIP_DATE (
        type: datePicker
        label {
            label: Required Ship Date
            alignment: left
        }
        layout {
            sequence: 70
            region: @HEADER_FORM
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @HEADER_FORM
            column: REQUIRED_SHIP_DATE
            dataType: date
        }
        help {
            helpText: Date this order must ship by.
        }
    )

    pageItem P91_PRIORITY (
        type: textField
        label {
            label: Priority
            alignment: left
        }
        layout {
            sequence: 80
            region: @HEADER_FORM
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @HEADER_FORM
            column: PRIORITY
            dataType: varchar2
        }
        help {
            helpText: Optional priority marker for this order (e.g. HIGH, LOW).
        }
    )

    pageItem P91_STATUS (
        type: displayOnly
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 90
            region: @HEADER_FORM
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @HEADER_FORM
            column: STATUS
            dataType: varchar2
            queryOnly: true
        }
    )

    region LINES_GRID (
        name: Outbound Order Lines
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    line_id,
                    order_id,
                    item_id,
                    qty_ordered,
                    qty_allocated,
                    qty_picked,
                    qty_shipped,
                    status
                from outbound_order_line
                where order_id = :P91_ORDER_ID
                order by line_id
                ```
            pageItemsToSubmit: [
                P91_ORDER_ID
            ]
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P91_ORDER_ID
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No lines for this order yet. Add a line below.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @LINE_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @ITEM_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @QTY_ORDERED
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @QTY_ALLOCATED
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @QTY_PICKED
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @QTY_SHIPPED
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @STATUS
                layout {
                    sequence: 7
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column LINE_ID (
            type: hidden
            layout {
                sequence: 15
            }
            source {
                databaseColumn: LINE_ID
                dataType: number
                primaryKey: true
            }
        )

        column LINE_ORDER_ID (
            type: hidden
            layout {
                sequence: 16
            }
            default {
                type: item
                item: P91_ORDER_ID
            }
            source {
                databaseColumn: ORDER_ID
                dataType: number
            }
        )

        column ITEM_ID (
            type: selectList
            heading {
                heading: Item
            }
            layout {
                sequence: 20
            }
            lov {
                type: sharedComponent
                lov: @item-active
            }
            source {
                databaseColumn: ITEM_ID
                dataType: number
            }
        )

        column QTY_ORDERED (
            type: numberField
            heading {
                heading: Qty Ordered
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                databaseColumn: QTY_ORDERED
                dataType: number
            }
        )

        column QTY_ALLOCATED (
            type: numberField
            heading {
                heading: Qty Allocated
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: QTY_ALLOCATED
                dataType: number
            }
        )

        column QTY_PICKED (
            type: numberField
            heading {
                heading: Qty Picked
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: QTY_PICKED
                dataType: number
            }
        )

        column QTY_SHIPPED (
            type: numberField
            heading {
                heading: Qty Shipped
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: QTY_SHIPPED
                dataType: number
            }
        )

        column STATUS (
            type: selectList
            heading {
                heading: Status
            }
            layout {
                sequence: 70
            }
            lov {
                type: staticValues
                staticValues: STATIC:Pending;PENDING,Allocated;ALLOCATED,Picked;PICKED,Short;SHORT,Cancelled;CANCELLED
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
        )
    )

    region SHIP_DETAILS (
        name: Ship Details
        type: staticContent
        layout {
            sequence: 35
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :P91_ORDER_ID IS NOT NULL AND NVL(:P91_STATUS,'X') = 'PACKED'
        }
    )

    pageItem P91_CARRIER (
        type: textField
        label {
            label: Carrier
            alignment: left
        }
        layout {
            sequence: 10
            region: @SHIP_DETAILS
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 60
        }
        help {
            helpText: Optional carrier name for this shipment.
        }
    )

    pageItem P91_TRACKING_NUMBER (
        type: textField
        label {
            label: Tracking Number
            alignment: left
        }
        layout {
            sequence: 20
            region: @SHIP_DETAILS
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 60
        }
        help {
            helpText: Optional carrier tracking number for this shipment.
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Back to List
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 90
                clearCache: 90
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Delete this outbound order and all its lines? This cannot be undone.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P91_ORDER_ID
        }
    )

    button ALLOCATE_ORDER_BTN (
        buttonName: ALLOCATE_ORDER_BTN
        label: Allocate
        layout {
            sequence: 22
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Allocate this order? This reserves stock for each line (PICK_FACE before BULK, FEFO by lot expiry) and creates the pick tasks used on the Pick Tasks screen.
            style: warning
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :P91_ORDER_ID IS NOT NULL AND NVL(:P91_STATUS,'X') = 'RECEIVED'
        }
    )

    button CANCEL_ORDER_BTN (
        buttonName: CANCEL_ORDER_BTN
        label: Cancel Order
        layout {
            sequence: 23
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Cancel this order? This releases any reserved/allocated stock, cancels every line and pick task, and cannot be undone.
            style: danger
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :P91_ORDER_ID IS NOT NULL AND NVL(:P91_STATUS,'X') NOT IN ('SHIPPED','CANCELLED')
        }
    )

    button PACK_ORDER_BTN (
        buttonName: PACK_ORDER_BTN
        label: Pack Order
        layout {
            sequence: 25
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Pack this order? This builds package lines from the picked pick tasks and moves the order to PACKED.
            style: warning
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :P91_ORDER_ID IS NOT NULL AND NVL(:P91_STATUS,'X') = 'PICKED'
        }
    )

    button SHIP_ORDER_BTN (
        buttonName: SHIP_ORDER_BTN
        label: Ship Order
        layout {
            sequence: 26
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Ship this order? This removes the packed stock from the shipping staging location and closes the order. This cannot be undone.
            style: warning
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :P91_ORDER_ID IS NOT NULL AND NVL(:P91_STATUS,'X') = 'PACKED'
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Save Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P91_ORDER_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P91_ORDER_ID
        }
    )

    process initialize-header-form (
        name: Initialize Order Header
        type: formInitialization
        formRegion: @HEADER_FORM
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-header-form (
        name: Process Order Header
        type: formAutoRowProcessing
        formRegion: @HEADER_FORM
        execution {
            sequence: 20
        }
    )

    process allocate-order-proc (
        name: Allocate Order
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    pkg_outbound.allocate_order(p_order_id => :P91_ORDER_ID);
                exception
                    when others then
                        apex_error.add_error(
                            p_message          => sqlerrm,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 33
        }
        successMessage {
            successMessage: Order allocated -- stock reserved and pick tasks created where available. Lines with insufficient stock are left SHORT.
        }
        serverSideCondition {
            whenButtonPressed: @ALLOCATE_ORDER_BTN
        }
    )

    process cancel-order-proc (
        name: Cancel Order
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    pkg_outbound.cancel_order(p_order_id => :P91_ORDER_ID);
                exception
                    when others then
                        apex_error.add_error(
                            p_message          => sqlerrm,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 34
        }
        successMessage {
            successMessage: Order cancelled -- any reserved/allocated stock has been released.
        }
        serverSideCondition {
            whenButtonPressed: @CANCEL_ORDER_BTN
        }
    )

    process LINES_GRID_ARP (
        name: Outbound Order Lines - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @LINES_GRID
        execution {
            sequence: 30
        }
    )

    process pack-order-proc (
        name: Pack Order
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_package_id ship_package.package_id%type;
                begin
                    l_package_id := pkg_packing.pack_order(p_order_id => :P91_ORDER_ID);
                exception
                    when others then
                        apex_error.add_error(
                            p_message          => sqlerrm,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 35
        }
        successMessage {
            successMessage: Order packed successfully.
        }
        serverSideCondition {
            whenButtonPressed: @PACK_ORDER_BTN
        }
    )

    process ship-order-proc (
        name: Ship Order
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_shipment_id shipment.shipment_id%type;
                begin
                    l_shipment_id := pkg_shipment.ship_order(
                        p_order_id        => :P91_ORDER_ID,
                        p_carrier         => :P91_CARRIER,
                        p_tracking_number => :P91_TRACKING_NUMBER
                    );
                exception
                    when others then
                        apex_error.add_error(
                            p_message          => sqlerrm,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 36
        }
        successMessage {
            successMessage: Order shipped successfully.
        }
        serverSideCondition {
            whenButtonPressed: @SHIP_ORDER_BTN
        }
    )

)
