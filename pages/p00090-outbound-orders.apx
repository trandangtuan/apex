page 90 (
    name: Outbound Orders
    alias: OUTBOUND-ORDERS
    title: Outbound Orders
    pageGroup: @outbound
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Outbound order headers (FR-04). Click a row's detail icon to open the order, manage its lines, and pack/ship it. Use New Order to create one.
    }

    region breadcrumb (
        name: Outbound Orders
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region OUTBOUND_ORDERS_IR (
        name: Outbound Orders
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    o.order_id,
                    o.order_number,
                    c.customer_name,
                    w.warehouse_name,
                    o.order_source,
                    o.order_date,
                    o.required_ship_date,
                    o.priority,
                    o.status,
                    (select count(*) from outbound_order_line ol where ol.order_id = o.order_id) as line_count
                from outbound_order o
                join customer c on c.customer_id = o.customer_id
                join warehouse w on w.warehouse_id = o.warehouse_id
                order by o.order_id desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 91
                items: {
                    P91_ORDER_ID: #ORDER_ID#
                }
                clearCache: 91
            }
            linkIcon: <span role="img" aria-label="Detail" class="fa fa-search-plus" title="View Detail"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No outbound orders found.
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        column ORDER_ID (
            type: hidden
            heading {
                heading: Order Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column ORDER_NUMBER (
            type: plainText
            heading {
                heading: Order Number
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column WAREHOUSE_NAME (
            type: plainText
            heading {
                heading: Warehouse
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column ORDER_SOURCE (
            type: plainText
            heading {
                heading: Order Source
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column ORDER_DATE (
            type: plainText
            heading {
                heading: Order Date
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                dataType: DATE
            }
        )

        column REQUIRED_SHIP_DATE (
            type: plainText
            heading {
                heading: Required Ship Date
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                dataType: DATE
            }
        )

        column PRIORITY (
            type: plainText
            heading {
                heading: Priority
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

        column LINE_COUNT (
            type: plainText
            heading {
                heading: Lines
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )
    )

    button NEW_ORDER (
        buttonName: NEW_ORDER
        label: New Order
        layout {
            sequence: 10
            region: @OUTBOUND_ORDERS_IR
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
            hot: true
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 91
                clearCache: 91
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
