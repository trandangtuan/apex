page 90 (
    name: Outbound Orders
    alias: OUTBOUND-ORDERS
    title: Outbound Orders
    pageGroup: @outbound
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Outbound order headers (FR-04). Customer and Warehouse are selected from active master lists. STATUS moves through received/allocated/picking/picked/packed/shipped automatically via PKG_OUTBOUND/PKG_PICKING/PKG_PACKING/PKG_SHIPMENT, not by direct edit. Use Pack Order below once every line of an order is PICKED.
    }

    region breadcrumb (
        name: Outbound Orders
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region OUTBOUND_ORDERS_GRID (
        name: Outbound Orders
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    order_id,
                    order_number,
                    customer_id,
                    warehouse_id,
                    order_source,
                    order_date,
                    required_ship_date,
                    priority,
                    status
                from outbound_order
                order by order_id desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No outbound orders found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @ORDER_NUMBER
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @CUSTOMER_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @WAREHOUSE_ID
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @ORDER_SOURCE
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @ORDER_DATE
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @REQUIRED_SHIP_DATE
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @PRIORITY
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @STATUS
                layout {
                    sequence: 8
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ORDER_ID (
            type: hidden
            layout {
                sequence: 15
            }
            source {
                databaseColumn: ORDER_ID
                dataType: number
                primaryKey: true
            }
        )

        column ORDER_NUMBER (
            type: textField
            heading {
                heading: Order Number
            }
            layout {
                sequence: 20
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ORDER_NUMBER
                dataType: varchar2
            }
        )

        column CUSTOMER_ID (
            type: selectList
            heading {
                heading: Customer
            }
            layout {
                sequence: 30
            }
            lov {
                type: sharedComponent
                lov: @customer-active
            }
            source {
                databaseColumn: CUSTOMER_ID
                dataType: number
            }
        )

        column WAREHOUSE_ID (
            type: selectList
            heading {
                heading: Warehouse
            }
            layout {
                sequence: 40
            }
            lov {
                type: sharedComponent
                lov: @warehouse-active
            }
            source {
                databaseColumn: WAREHOUSE_ID
                dataType: number
            }
        )

        column ORDER_SOURCE (
            type: textField
            heading {
                heading: Order Source
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: ORDER_SOURCE
                dataType: varchar2
            }
        )

        column ORDER_DATE (
            type: datePicker
            heading {
                heading: Order Date
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: ORDER_DATE
                dataType: date
            }
        )

        column REQUIRED_SHIP_DATE (
            type: datePicker
            heading {
                heading: Required Ship Date
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: REQUIRED_SHIP_DATE
                dataType: date
            }
        )

        column PRIORITY (
            type: textField
            heading {
                heading: Priority
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: PRIORITY
                dataType: varchar2
            }
        )

        column STATUS (
            type: selectList
            heading {
                heading: Status
            }
            layout {
                sequence: 90
            }
            lov {
                type: staticValues
                staticValues: STATIC:Received;RECEIVED,Allocated;ALLOCATED,Picking;PICKING,Picked;PICKED,Packed;PACKED,Shipped;SHIPPED,Cancelled;CANCELLED
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
        )
    )

    process OUTBOUND_ORDERS_GRID_ARP (
        name: Outbound Orders - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @OUTBOUND_ORDERS_GRID
        execution {
            sequence: 10
        }
    )

    region PACK_ORDER (
        name: Pack Order
        type: staticContent
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P90_PACK_ORDER_ID (
        type: selectList
        label {
            label: Order (fully picked)
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select order_number as d, order_id as r
                  from outbound_order
                 where status = 'PICKED'
                 order by order_id desc
                ```
        }
        layout {
            sequence: 10
            region: @PACK_ORDER
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Only orders with every line PICKED are listed. Packing builds package lines from the picked pick tasks and moves the order to PACKED.
        }
    )

    region PACK_BUTTONS (
        name: Pack Buttons
        type: staticContent
        layout {
            sequence: 31
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button PACK_ORDER_BTN (
        buttonName: PACK_ORDER_BTN
        label: Pack Order
        layout {
            sequence: 10
            region: @PACK_BUTTONS
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Pack this order? This builds package lines from the picked pick tasks and moves the order to PACKED.
            style: warning
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P90_PACK_ORDER_ID
        }
    )

    process pack-order-proc (
        name: Pack Order
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_package_id ship_package.package_id%type;
                begin
                    l_package_id := pkg_packing.pack_order(p_order_id => :P90_PACK_ORDER_ID);
                    :P90_PACK_ORDER_ID := null;
                exception
                    when others then
                        apex_error.add_error(
                            p_message          => sqlerrm,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Order packed successfully.
        }
        serverSideCondition {
            whenButtonPressed: @PACK_ORDER_BTN
        }
    )

)
