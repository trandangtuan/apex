page 101 (
    name: Outbound Order Line Form
    alias: OUTBOUND-ORDER-LINE-FORM
    title: Outbound Order Line Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Create or update one outbound order line (FR-04). Order and Item are selected from master lists. Prefer driving QTY_ALLOCATED/QTY_PICKED/QTY_SHIPPED/STATUS through PKG_OUTBOUND.allocate_line and PKG_PICKING.confirm_pick rather than editing them here directly.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Outbound Order Line Form
        type: form
        source {
            location: localDatabase
            tableName: OUTBOUND_ORDER_LINE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P101_LINE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: LINE_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P101_SUCCESS_MESSAGE (
        type: hidden
        layout {
            sequence: 11
            region: @form
            slot: regionBody
        }
    )

    pageItem P101_ORDER_ID (
        type: selectList
        label {
            label: Order
        }
        lov {
            type: sharedComponent
            lov: @outbound-order-any
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ORDER_ID
            dataType: number
        }
        help {
            helpText: Order header this line belongs to.
        }
    )

    pageItem P101_ITEM_ID (
        type: selectList
        label {
            label: Item
        }
        lov {
            type: sharedComponent
            lov: @item-active
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ITEM_ID
            dataType: number
        }
        help {
            helpText: Item ordered on this line, selected from the active Item master list.
        }
    )

    pageItem P101_QTY_ORDERED (
        type: numberField
        label {
            label: Qty Ordered
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: QTY_ORDERED
            dataType: number
        }
        help {
            helpText: Quantity requested by the customer on this line.
        }
    )

    pageItem P101_QTY_ALLOCATED (
        type: numberField
        label {
            label: Qty Allocated
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 0
        }
        source {
            formRegion: @form
            column: QTY_ALLOCATED
            dataType: number
        }
        help {
            helpText: Normally maintained by PKG_OUTBOUND.allocate_line; edit here only to correct a mistake.
        }
    )

    pageItem P101_QTY_PICKED (
        type: numberField
        label {
            label: Qty Picked
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 0
        }
        source {
            formRegion: @form
            column: QTY_PICKED
            dataType: number
        }
        help {
            helpText: Normally maintained by PKG_PICKING.confirm_pick; edit here only to correct a mistake.
        }
    )

    pageItem P101_QTY_SHIPPED (
        type: numberField
        label {
            label: Qty Shipped
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 0
        }
        source {
            formRegion: @form
            column: QTY_SHIPPED
            dataType: number
        }
        help {
            helpText: Normally maintained by PKG_SHIPMENT; edit here only to correct a mistake.
        }
    )

    pageItem P101_STATUS (
        type: selectList
        label {
            label: Status
        }
        lov {
            type: staticValues
            staticValues: STATIC:Pending;PENDING,Allocated;ALLOCATED,Picked;PICKED,Short;SHORT,Cancelled;CANCELLED
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: PENDING
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: STATUS
            dataType: varchar2
        }
        help {
            helpText: Normally advanced automatically by PKG_OUTBOUND/PKG_PICKING; edit here only to correct a mistake.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P101_LINE_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P101_LINE_ID
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P101_LINE_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process initialize-form-form (
        name: Initialize form Form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process set-success-message-form (
        name: Set Success Message
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P101_SUCCESS_MESSAGE :=
                    case :REQUEST
                        when 'CREATE' then 'Outbound order line was created successfully.'
                        when 'APPLY-CHANGES' then 'Outbound order line was updated successfully.'
                        when 'DELETE' then 'Outbound order line was deleted successfully.'
                        else null
                    end;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process process-form-form (
        name: Process form Form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &P101_SUCCESS_MESSAGE.
        }
    )

)
