page 20 (
    name: Locations
    alias: LOCATIONS
    title: Locations
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Browse and maintain warehouse storage locations / bins (FR-01, FR-05). Warehouse is selected from the active Warehouse master list.
    }

    region breadcrumb (
        name: Locations
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region LOCATIONS_GRID (
        name: Locations
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    location_id,
                    location_code,
                    warehouse_id,
                    zone,
                    aisle,
                    rack,
                    shelf,
                    location_type,
                    is_active
                from location
                order by location_code
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No locations found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @LOCATION_CODE
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @WAREHOUSE_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @ZONE
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @AISLE
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @RACK
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @SHELF
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @LOCATION_TYPE
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @IS_ACTIVE
                layout {
                    sequence: 8
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column LOCATION_ID (
            type: hidden
            layout {
                sequence: 15
            }
            source {
                databaseColumn: LOCATION_ID
                dataType: number
                primaryKey: true
            }
        )

        column LOCATION_CODE (
            type: textField
            heading {
                heading: Location Code
            }
            layout {
                sequence: 20
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: LOCATION_CODE
                dataType: varchar2
            }
        )

        column WAREHOUSE_ID (
            type: selectList
            heading {
                heading: Warehouse
            }
            layout {
                sequence: 30
            }
            lov {
                type: sharedComponent
                lov: @warehouse-active
            }
            source {
                databaseColumn: WAREHOUSE_ID
                dataType: number
            }
        )

        column ZONE (
            type: textField
            heading {
                heading: Zone
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: ZONE
                dataType: varchar2
            }
        )

        column AISLE (
            type: textField
            heading {
                heading: Aisle
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: AISLE
                dataType: varchar2
            }
        )

        column RACK (
            type: textField
            heading {
                heading: Rack
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: RACK
                dataType: varchar2
            }
        )

        column SHELF (
            type: textField
            heading {
                heading: Shelf
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: SHELF
                dataType: varchar2
            }
        )

        column LOCATION_TYPE (
            type: selectList
            heading {
                heading: Location Type
            }
            layout {
                sequence: 80
            }
            lov {
                type: staticValues
                staticValues: STATIC:Receiving;RECEIVING,Pick Face;PICK_FACE,Bulk;BULK,Quarantine;QUARANTINE,Staging;STAGING,Shipping;SHIPPING
            }
            source {
                databaseColumn: LOCATION_TYPE
                dataType: varchar2
            }
        )

        column IS_ACTIVE (
            type: checkbox
            heading {
                heading: Active
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: IS_ACTIVE
                dataType: varchar2
            }
        )
    )

    process LOCATIONS_GRID_ARP (
        name: Locations - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @LOCATIONS_GRID
        execution {
            sequence: 10
        }
    )

)
