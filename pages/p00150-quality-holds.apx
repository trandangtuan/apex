page 150 (
    name: Quality Holds
    alias: QUALITY-HOLDS
    title: Quality Holds
    pageGroup: @quality
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Active/released stock holds (FR-07). Item, Lot and Location are selected from master lists (leave Lot/Location blank to apply the hold to every lot/location of that item). PKG_OUTBOUND.allocate_line excludes any inventory_balance row matched by an ACTIVE hold here. Creating a row here places a hold immediately; prefer PKG_QUALITY.release_hold over deleting a row, so RELEASED_BY/RELEASE_DATE stay accurate.
    }

    region breadcrumb (
        name: Quality Holds
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region QUALITY_HOLDS_GRID (
        name: Quality Holds
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    hold_id,
                    item_id,
                    lot_id,
                    location_id,
                    reason,
                    hold_date,
                    released_by,
                    release_date,
                    status
                from quality_hold
                order by hold_id desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No quality holds found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @ITEM_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @LOT_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @LOCATION_ID
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @REASON
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @HOLD_DATE
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @RELEASED_BY
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @RELEASE_DATE
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @STATUS
                layout {
                    sequence: 8
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column HOLD_ID (
            type: hidden
            layout {
                sequence: 15
            }
            source {
                databaseColumn: HOLD_ID
                dataType: number
                primaryKey: true
            }
        )

        column ITEM_ID (
            type: selectList
            heading {
                heading: Item
            }
            layout {
                sequence: 20
            }
            lov {
                type: sharedComponent
                lov: @item-active
            }
            source {
                databaseColumn: ITEM_ID
                dataType: number
            }
        )

        column LOT_ID (
            type: selectList
            heading {
                heading: Lot
            }
            layout {
                sequence: 30
            }
            lov {
                type: sharedComponent
                lov: @lot-any
                displayExtraValues: true
            }
            source {
                databaseColumn: LOT_ID
                dataType: number
            }
        )

        column LOCATION_ID (
            type: selectList
            heading {
                heading: Location
            }
            layout {
                sequence: 40
            }
            lov {
                type: sharedComponent
                lov: @location-active
                displayExtraValues: true
            }
            source {
                databaseColumn: LOCATION_ID
                dataType: number
            }
        )

        column REASON (
            type: textField
            heading {
                heading: Reason
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: REASON
                dataType: varchar2
            }
        )

        column HOLD_DATE (
            type: datePicker
            heading {
                heading: Hold Date
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: HOLD_DATE
                dataType: date
            }
        )

        column RELEASED_BY (
            type: textField
            heading {
                heading: Released By
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 60
            }
            source {
                databaseColumn: RELEASED_BY
                dataType: varchar2
            }
        )

        column RELEASE_DATE (
            type: datePicker
            heading {
                heading: Release Date
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: RELEASE_DATE
                dataType: date
            }
        )

        column STATUS (
            type: selectList
            heading {
                heading: Status
            }
            layout {
                sequence: 90
            }
            lov {
                type: staticValues
                staticValues: STATIC:Active;ACTIVE,Released;RELEASED
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
        )
    )

    process QUALITY_HOLDS_GRID_ARP (
        name: Quality Holds - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @QUALITY_HOLDS_GRID
        execution {
            sequence: 10
        }
    )

)
