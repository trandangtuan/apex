page 150 (
    name: Quality Holds
    alias: QUALITY-HOLDS
    title: Quality Holds
    pageGroup: @quality
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Active/released stock holds (FR-07). Select a row and click Edit to open it, or use New Hold to place one. Item, Lot and Location are selected from master lists (leave Lot/Location blank to apply the hold to every lot/location of that item). PKG_OUTBOUND.allocate_line excludes any inventory matched by an ACTIVE hold here. Prefer PKG_QUALITY.release_hold over deleting a row, so RELEASED_BY/RELEASE_DATE stay accurate.
    }

    region breadcrumb (
        name: Quality Holds
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Actions
        type: staticContent
        layout {
            sequence: 15
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P150_EDIT_SELECT (
        type: numberField
        label {
            label: Hold Id to Edit
        }
        layout {
            sequence: 10
            region: @actions
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Enter the Hold Id shown below, then click Edit to open it.
        }
    )

    button edit-hold (
        buttonName: EDIT_HOLD
        label: Edit
        layout {
            sequence: 20
            region: @actions
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 151
                items: {
                    P151_HOLD_ID: &P150_EDIT_SELECT.
                }
                clearCache: 151
            }
        }
    )

    button create-hold (
        buttonName: CREATE_HOLD
        label: New Hold
        layout {
            sequence: 30
            region: @actions
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 151
                clearCache: 151
            }
        }
    )

    region QUALITY_HOLDS_REPORT (
        name: Quality Holds
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    qh.hold_id,
                    i.item_code,
                    lt.lot_number,
                    loc.location_code,
                    qh.reason,
                    qh.hold_date,
                    qh.released_by,
                    qh.release_date,
                    qh.status
                from quality_hold qh
                join item i on i.item_id = qh.item_id
                left join lot lt on lt.lot_id = qh.lot_id
                left join location loc on loc.location_id = qh.location_id
                order by qh.hold_id desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No quality holds found.
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        column HOLD_ID (
            type: plainText
            heading {
                heading: Hold Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column ITEM_CODE (
            type: plainText
            heading {
                heading: Item
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column LOT_NUMBER (
            type: plainText
            heading {
                heading: Lot
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column LOCATION_CODE (
            type: plainText
            heading {
                heading: Location
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column REASON (
            type: plainText
            heading {
                heading: Reason
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column HOLD_DATE (
            type: plainText
            heading {
                heading: Hold Date
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                dataType: DATE
            }
        )

        column RELEASED_BY (
            type: plainText
            heading {
                heading: Released By
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column RELEASE_DATE (
            type: plainText
            heading {
                heading: Release Date
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                dataType: DATE
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )
    )

    dynamicAction refresh-on-edit (
        name: Refresh on Edit
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @QUALITY_HOLDS_REPORT
        }

        action refresh-quality-holds-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @QUALITY_HOLDS_REPORT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

)
