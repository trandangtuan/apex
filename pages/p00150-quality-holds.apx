page 150 (
    name: Quality Holds
    alias: QUALITY-HOLDS
    title: Quality Holds
    pageGroup: @quality
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Active/released stock holds (FR-07), read-only report. Use Place Hold below to hold an item/lot/location (leave Lot/Location blank to apply to every lot/location of that item) via PKG_QUALITY.place_hold, and Release Hold to release one via PKG_QUALITY.release_hold. PKG_OUTBOUND.allocate_line excludes any inventory_balance row matched by an ACTIVE hold here.
    }

    region breadcrumb (
        name: Quality Holds
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region QUALITY_HOLDS_GRID (
        name: Quality Holds
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    hold_id,
                    item_id,
                    lot_id,
                    location_id,
                    reason,
                    hold_date,
                    released_by,
                    release_date,
                    status
                from quality_hold
                order by hold_id desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No quality holds found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @ITEM_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @LOT_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @LOCATION_ID
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @REASON
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @HOLD_DATE
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @RELEASED_BY
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @RELEASE_DATE
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @STATUS
                layout {
                    sequence: 8
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column HOLD_ID (
            type: hidden
            layout {
                sequence: 15
            }
            source {
                databaseColumn: HOLD_ID
                dataType: number
                primaryKey: true
            }
        )

        column ITEM_ID (
            type: selectList
            heading {
                heading: Item
            }
            layout {
                sequence: 20
            }
            lov {
                type: sharedComponent
                lov: @item-active
            }
            source {
                databaseColumn: ITEM_ID
                dataType: number
            }
        )

        column LOT_ID (
            type: selectList
            heading {
                heading: Lot
            }
            layout {
                sequence: 30
            }
            lov {
                type: sharedComponent
                lov: @lot-any
                displayExtraValues: true
            }
            source {
                databaseColumn: LOT_ID
                dataType: number
            }
        )

        column LOCATION_ID (
            type: selectList
            heading {
                heading: Location
            }
            layout {
                sequence: 40
            }
            lov {
                type: sharedComponent
                lov: @location-active
                displayExtraValues: true
            }
            source {
                databaseColumn: LOCATION_ID
                dataType: number
            }
        )

        column REASON (
            type: textField
            heading {
                heading: Reason
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: REASON
                dataType: varchar2
            }
        )

        column HOLD_DATE (
            type: datePicker
            heading {
                heading: Hold Date
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: HOLD_DATE
                dataType: date
            }
        )

        column RELEASED_BY (
            type: textField
            heading {
                heading: Released By
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 60
            }
            source {
                databaseColumn: RELEASED_BY
                dataType: varchar2
            }
        )

        column RELEASE_DATE (
            type: datePicker
            heading {
                heading: Release Date
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: RELEASE_DATE
                dataType: date
            }
        )

        column STATUS (
            type: selectList
            heading {
                heading: Status
            }
            layout {
                sequence: 90
            }
            lov {
                type: staticValues
                staticValues: STATIC:Active;ACTIVE,Released;RELEASED
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
        )
    )

    region PLACE_HOLD (
        name: Place Hold
        type: staticContent
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P150_HOLD_ITEM_ID (
        type: selectList
        label {
            label: Item
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @item-active
        }
        layout {
            sequence: 10
            region: @PLACE_HOLD
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: Item to place on hold. Only active items are listed.
        }
    )

    pageItem P150_HOLD_LOT_ID (
        type: selectList
        label {
            label: Lot (optional)
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lot-any
            displayExtraValues: true
        }
        layout {
            sequence: 20
            region: @PLACE_HOLD
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Leave blank to hold every lot of the item; select one to hold only that lot.
        }
    )

    pageItem P150_HOLD_LOCATION_ID (
        type: selectList
        label {
            label: Location (optional)
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @location-active
            displayExtraValues: true
        }
        layout {
            sequence: 30
            region: @PLACE_HOLD
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Leave blank to hold every location of the item; select one to hold only that location.
        }
    )

    pageItem P150_HOLD_REASON (
        type: textField
        label {
            label: Reason
            alignment: left
        }
        layout {
            sequence: 40
            region: @PLACE_HOLD
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        help {
            helpText: Why this hold is being placed (e.g. failed inspection, recall, damage).
        }
    )

    region PLACE_HOLD_BUTTONS (
        name: Place Hold Buttons
        type: staticContent
        layout {
            sequence: 31
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button PLACE_HOLD_BTN (
        buttonName: PLACE_HOLD_BTN
        label: Place Hold
        layout {
            sequence: 10
            region: @PLACE_HOLD_BUTTONS
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Place this hold? PKG_OUTBOUND.allocate_line will immediately stop allocating any matching stock.
            style: warning
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P150_HOLD_ITEM_ID
        }
    )

    process place-hold-proc (
        name: Place Hold
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_hold_id quality_hold.hold_id%type;
                begin
                    l_hold_id := pkg_quality.place_hold(
                        p_item_id     => :P150_HOLD_ITEM_ID,
                        p_reason      => :P150_HOLD_REASON,
                        p_lot_id      => :P150_HOLD_LOT_ID,
                        p_location_id => :P150_HOLD_LOCATION_ID
                    );
                    :P150_HOLD_ITEM_ID := null;
                    :P150_HOLD_LOT_ID := null;
                    :P150_HOLD_LOCATION_ID := null;
                    :P150_HOLD_REASON := null;
                exception
                    when others then
                        apex_error.add_error(
                            p_message          => sqlerrm,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Hold placed successfully.
        }
        serverSideCondition {
            whenButtonPressed: @PLACE_HOLD_BTN
        }
    )

    region RELEASE_HOLD (
        name: Release Hold
        type: staticContent
        layout {
            sequence: 32
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P150_RELEASE_HOLD_ID (
        type: selectList
        label {
            label: Active Hold
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.item_code || ' -- ' || h.reason || ' (' || to_char(h.hold_date, 'DD-MON-YYYY') || ')' as d,
                       h.hold_id as r
                  from quality_hold h
                  join item i on i.item_id = h.item_id
                 where h.status = 'ACTIVE'
                 order by h.hold_id desc
                ```
        }
        layout {
            sequence: 10
            region: @RELEASE_HOLD
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Only ACTIVE holds are listed.
        }
    )

    region RELEASE_HOLD_BUTTONS (
        name: Release Hold Buttons
        type: staticContent
        layout {
            sequence: 33
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button RELEASE_HOLD_BTN (
        buttonName: RELEASE_HOLD_BTN
        label: Release Hold
        layout {
            sequence: 10
            region: @RELEASE_HOLD_BUTTONS
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Release this hold? Matching stock becomes allocatable again.
            style: warning
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P150_RELEASE_HOLD_ID
        }
    )

    process release-hold-proc (
        name: Release Hold
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    pkg_quality.release_hold(p_hold_id => :P150_RELEASE_HOLD_ID);
                    :P150_RELEASE_HOLD_ID := null;
                exception
                    when others then
                        apex_error.add_error(
                            p_message          => sqlerrm,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Hold released successfully.
        }
        serverSideCondition {
            whenButtonPressed: @RELEASE_HOLD_BTN
        }
    )

)
