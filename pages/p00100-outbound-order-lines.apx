page 100 (
    name: Outbound Order Lines
    alias: OUTBOUND-ORDER-LINES
    title: Outbound Order Lines
    pageGroup: @outbound
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Outbound order lines (FR-04). Order and Item are selected from active master lists. QTY_ALLOCATED/QTY_PICKED/QTY_SHIPPED/STATUS are maintained by PKG_OUTBOUND.allocate_line and PKG_PICKING.confirm_pick, not by direct edit.
    }

    region breadcrumb (
        name: Outbound Order Lines
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region OUTBOUND_ORDER_LINES_GRID (
        name: Outbound Order Lines
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    line_id,
                    order_id,
                    item_id,
                    qty_ordered,
                    qty_allocated,
                    qty_picked,
                    qty_shipped,
                    status
                from outbound_order_line
                order by order_id desc, line_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No outbound order lines found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @LINE_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @ORDER_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @ITEM_ID
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @QTY_ORDERED
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @QTY_ALLOCATED
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @QTY_PICKED
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @QTY_SHIPPED
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @STATUS
                layout {
                    sequence: 8
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column LINE_ID (
            type: hidden
            layout {
                sequence: 15
            }
            source {
                databaseColumn: LINE_ID
                dataType: number
                primaryKey: true
            }
        )

        column ORDER_ID (
            type: selectList
            heading {
                heading: Order
            }
            layout {
                sequence: 20
            }
            lov {
                type: sharedComponent
                lov: @outbound-order-any
            }
            source {
                databaseColumn: ORDER_ID
                dataType: number
            }
        )

        column ITEM_ID (
            type: selectList
            heading {
                heading: Item
            }
            layout {
                sequence: 30
            }
            lov {
                type: sharedComponent
                lov: @item-active
            }
            source {
                databaseColumn: ITEM_ID
                dataType: number
            }
        )

        column QTY_ORDERED (
            type: numberField
            heading {
                heading: Qty Ordered
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: QTY_ORDERED
                dataType: number
            }
        )

        column QTY_ALLOCATED (
            type: numberField
            heading {
                heading: Qty Allocated
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: QTY_ALLOCATED
                dataType: number
            }
        )

        column QTY_PICKED (
            type: numberField
            heading {
                heading: Qty Picked
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: QTY_PICKED
                dataType: number
            }
        )

        column QTY_SHIPPED (
            type: numberField
            heading {
                heading: Qty Shipped
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: QTY_SHIPPED
                dataType: number
            }
        )

        column STATUS (
            type: selectList
            heading {
                heading: Status
            }
            layout {
                sequence: 80
            }
            lov {
                type: staticValues
                staticValues: STATIC:Pending;PENDING,Allocated;ALLOCATED,Picked;PICKED,Short;SHORT,Cancelled;CANCELLED
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
        )
    )

    process OUTBOUND_ORDER_LINES_GRID_ARP (
        name: Outbound Order Lines - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @OUTBOUND_ORDER_LINES_GRID
        execution {
            sequence: 10
        }
    )

)
