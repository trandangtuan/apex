page 100 (
    name: Outbound Order Lines
    alias: OUTBOUND-ORDER-LINES
    title: Outbound Order Lines
    pageGroup: @outbound
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Outbound order lines (FR-04). Select a line and click Edit to open it, or use New Line to add one. Order and Item are selected from master lists. QTY_ALLOCATED/QTY_PICKED/QTY_SHIPPED/STATUS are normally maintained by PKG_OUTBOUND.allocate_line and PKG_PICKING.confirm_pick, not by direct edit.
    }

    region breadcrumb (
        name: Outbound Order Lines
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Actions
        type: staticContent
        layout {
            sequence: 15
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P100_EDIT_SELECT (
        type: numberField
        label {
            label: Line Id to Edit
        }
        layout {
            sequence: 10
            region: @actions
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Enter the Line Id shown below, then click Edit to open it.
        }
    )

    button edit-line (
        buttonName: EDIT_LINE
        label: Edit
        layout {
            sequence: 20
            region: @actions
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 101
                items: {
                    P101_LINE_ID: &P100_EDIT_SELECT.
                }
                clearCache: 101
            }
        }
    )

    button create-line (
        buttonName: CREATE_LINE
        label: New Line
        layout {
            sequence: 30
            region: @actions
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 101
                clearCache: 101
            }
        }
    )

    region OUTBOUND_ORDER_LINES_REPORT (
        name: Outbound Order Lines
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    ol.line_id,
                    o.order_number,
                    i.item_code,
                    ol.qty_ordered,
                    ol.qty_allocated,
                    ol.qty_picked,
                    ol.qty_shipped,
                    ol.status
                from outbound_order_line ol
                join outbound_order o on o.order_id = ol.order_id
                join item i on i.item_id = ol.item_id
                order by ol.order_id desc, ol.line_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No outbound order lines found.
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        column LINE_ID (
            type: plainText
            heading {
                heading: Line Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column ORDER_NUMBER (
            type: plainText
            heading {
                heading: Order
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ITEM_CODE (
            type: plainText
            heading {
                heading: Item
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column QTY_ORDERED (
            type: plainText
            heading {
                heading: Qty Ordered
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column QTY_ALLOCATED (
            type: plainText
            heading {
                heading: Qty Allocated
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column QTY_PICKED (
            type: plainText
            heading {
                heading: Qty Picked
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column QTY_SHIPPED (
            type: plainText
            heading {
                heading: Qty Shipped
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )
    )

    dynamicAction refresh-on-edit (
        name: Refresh on Edit
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @OUTBOUND_ORDER_LINES_REPORT
        }

        action refresh-outbound-order-lines-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @OUTBOUND_ORDER_LINES_REPORT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

)
