page 61 (
    name: Inbound Receipt Form
    alias: INBOUND-RECEIPT-FORM
    title: Inbound Receipt Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Create or update one inbound receipt header (FR-02). Supplier and Warehouse are selected from their active master lists. Prefer driving RECEIVED/PUTAWAY/COMPLETED transitions through PKG_INBOUND rather than editing STATUS here directly.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Inbound Receipt Form
        type: form
        source {
            location: localDatabase
            tableName: INBOUND_RECEIPT
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P61_RECEIPT_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: RECEIPT_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P61_SUCCESS_MESSAGE (
        type: hidden
        layout {
            sequence: 11
            region: @form
            slot: regionBody
        }
    )

    pageItem P61_SUPPLIER_ID (
        type: selectList
        label {
            label: Supplier
        }
        lov {
            type: sharedComponent
            lov: @supplier-active
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: SUPPLIER_ID
            dataType: number
        }
        help {
            helpText: Supplier for this receipt, selected from the active Supplier master list.
        }
    )

    pageItem P61_PO_REFERENCE (
        type: textField
        label {
            label: PO Reference
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 40
        }
        source {
            formRegion: @form
            column: PO_REFERENCE
            dataType: varchar2
        }
        help {
            helpText: Optional purchase order reference from the supplier.
        }
    )

    pageItem P61_WAREHOUSE_ID (
        type: selectList
        label {
            label: Warehouse
        }
        lov {
            type: sharedComponent
            lov: @warehouse-active
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: WAREHOUSE_ID
            dataType: number
        }
        help {
            helpText: Receiving warehouse, selected from the active Warehouse master list.
        }
    )

    pageItem P61_EXPECTED_DATE (
        type: datePicker
        label {
            label: Expected Date
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: EXPECTED_DATE
            dataType: date
        }
        help {
            helpText: Date the shipment is expected to arrive.
        }
    )

    pageItem P61_STATUS (
        type: selectList
        label {
            label: Status
        }
        lov {
            type: staticValues
            staticValues: STATIC:Expected;EXPECTED,Receiving;RECEIVING,Completed;COMPLETED,Closed;CLOSED
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: EXPECTED
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: STATUS
            dataType: varchar2
        }
        help {
            helpText: Prefer PKG_INBOUND.receive_line / putaway_line / complete_receipt to advance this automatically.
        }
    )

    pageItem P61_RECEIVED_BY (
        type: textField
        label {
            label: Received By
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 60
        }
        source {
            formRegion: @form
            column: RECEIVED_BY
            dataType: varchar2
        }
        help {
            helpText: Name of the warehouse staff who received the shipment.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P61_RECEIPT_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P61_RECEIPT_ID
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P61_RECEIPT_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process initialize-form-form (
        name: Initialize form Form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process set-success-message-form (
        name: Set Success Message
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P61_SUCCESS_MESSAGE :=
                    case :REQUEST
                        when 'CREATE' then 'Inbound receipt was created successfully.'
                        when 'APPLY-CHANGES' then 'Inbound receipt was updated successfully.'
                        when 'DELETE' then 'Inbound receipt was deleted successfully.'
                        else null
                    end;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process process-form-form (
        name: Process form Form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &P61_SUCCESS_MESSAGE.
        }
    )

)
