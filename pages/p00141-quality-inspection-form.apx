page 141 (
    name: Quality Inspection Form
    alias: QUALITY-INSPECTION-FORM
    title: Quality Inspection Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Create or update one quality inspection record (FR-07). Item and Lot are selected from master lists. This is an audit entry only; call PKG_QUALITY.record_inspection to also cascade the result into the lot's QC status.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Quality Inspection Form
        type: form
        source {
            location: localDatabase
            tableName: QUALITY_INSPECTION
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P141_INSPECTION_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: INSPECTION_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P141_SUCCESS_MESSAGE (
        type: hidden
        layout {
            sequence: 11
            region: @form
            slot: regionBody
        }
    )

    pageItem P141_SOURCE_TYPE (
        type: selectList
        label {
            label: Source Type
        }
        lov {
            type: staticValues
            staticValues: STATIC:Inbound Line;INBOUND_LINE,Lot;LOT,Return;RETURN
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: SOURCE_TYPE
            dataType: varchar2
        }
        help {
            helpText: What triggered this inspection.
        }
    )

    pageItem P141_SOURCE_ID (
        type: numberField
        label {
            label: Source Id
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: SOURCE_ID
            dataType: number
        }
        help {
            helpText: Id of the inbound receipt line, lot or return this inspection refers to (matches Source Type).
        }
    )

    pageItem P141_ITEM_ID (
        type: selectList
        label {
            label: Item
        }
        lov {
            type: sharedComponent
            lov: @item-active
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ITEM_ID
            dataType: number
        }
        help {
            helpText: Item being inspected, selected from the active Item master list.
        }
    )

    pageItem P141_LOT_ID (
        type: selectList
        label {
            label: Lot
        }
        lov {
            type: sharedComponent
            lov: @lot-any
            displayNullValue: true
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: LOT_ID
            dataType: number
        }
        help {
            helpText: Optional lot/batch, when the inspection targets a specific lot.
        }
    )

    pageItem P141_INSPECTOR (
        type: textField
        label {
            label: Inspector
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 60
        }
        source {
            formRegion: @form
            column: INSPECTOR
            dataType: varchar2
        }
        help {
            helpText: Name of the person performing the inspection.
        }
    )

    pageItem P141_INSPECTION_DATE (
        type: datePicker
        label {
            label: Inspection Date
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: INSPECTION_DATE
            dataType: date
        }
        help {
            helpText: Date the inspection was performed.
        }
    )

    pageItem P141_RESULT (
        type: selectList
        label {
            label: Result
        }
        lov {
            type: staticValues
            staticValues: STATIC:Pass;PASS,Fail;FAIL,Conditional;CONDITIONAL
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: RESULT
            dataType: varchar2
        }
        help {
            helpText: Outcome of the inspection.
        }
    )

    pageItem P141_DEFECT_CODE (
        type: textField
        label {
            label: Defect Code
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @form
            column: DEFECT_CODE
            dataType: varchar2
        }
        help {
            helpText: Optional defect code when the result is Fail or Conditional.
        }
    )

    pageItem P141_NOTES (
        type: textarea
        label {
            label: Notes
        }
        layout {
            sequence: 100
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 400
        }
        source {
            formRegion: @form
            column: NOTES
            dataType: varchar2
        }
        help {
            helpText: Optional free-text notes about this inspection.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P141_INSPECTION_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P141_INSPECTION_ID
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P141_INSPECTION_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process initialize-form-form (
        name: Initialize form Form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process set-success-message-form (
        name: Set Success Message
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P141_SUCCESS_MESSAGE :=
                    case :REQUEST
                        when 'CREATE' then 'Quality inspection was created successfully.'
                        when 'APPLY-CHANGES' then 'Quality inspection was updated successfully.'
                        when 'DELETE' then 'Quality inspection was deleted successfully.'
                        else null
                    end;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process process-form-form (
        name: Process form Form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &P141_SUCCESS_MESSAGE.
        }
    )

)
