page 140 (
    name: Quality Inspections
    alias: QUALITY-INSPECTIONS
    title: Quality Inspections
    pageGroup: @quality
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Quality inspection records (FR-07). Item and Lot are selected from master lists. Rows created here are audit entries only; to have a PASS/FAIL result automatically update the lot's QC status, call PKG_QUALITY.record_inspection instead (e.g. from a future inspection action page).
    }

    region breadcrumb (
        name: Quality Inspections
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region QUALITY_INSPECTIONS_GRID (
        name: Quality Inspections
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    inspection_id,
                    source_type,
                    source_id,
                    item_id,
                    lot_id,
                    inspector,
                    inspection_date,
                    result,
                    defect_code,
                    notes
                from quality_inspection
                order by inspection_id desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No quality inspections found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @SOURCE_TYPE
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @SOURCE_ID
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @ITEM_ID
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @LOT_ID
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @INSPECTOR
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @INSPECTION_DATE
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @RESULT
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @DEFECT_CODE
                layout {
                    sequence: 8
                }
            )
            displayColumn (
                column: @NOTES
                layout {
                    sequence: 9
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column INSPECTION_ID (
            type: hidden
            layout {
                sequence: 15
            }
            source {
                databaseColumn: INSPECTION_ID
                dataType: number
                primaryKey: true
            }
        )

        column SOURCE_TYPE (
            type: selectList
            heading {
                heading: Source Type
            }
            layout {
                sequence: 20
            }
            lov {
                type: staticValues
                staticValues: STATIC:Inbound Line;INBOUND_LINE,Lot;LOT,Return;RETURN
            }
            source {
                databaseColumn: SOURCE_TYPE
                dataType: varchar2
            }
        )

        column SOURCE_ID (
            type: numberField
            heading {
                heading: Source Id
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: SOURCE_ID
                dataType: number
            }
        )

        column ITEM_ID (
            type: selectList
            heading {
                heading: Item
            }
            layout {
                sequence: 40
            }
            lov {
                type: sharedComponent
                lov: @item-active
            }
            source {
                databaseColumn: ITEM_ID
                dataType: number
            }
        )

        column LOT_ID (
            type: selectList
            heading {
                heading: Lot
            }
            layout {
                sequence: 50
            }
            lov {
                type: sharedComponent
                lov: @lot-any
                displayExtraValues: true
            }
            source {
                databaseColumn: LOT_ID
                dataType: number
            }
        )

        column INSPECTOR (
            type: textField
            heading {
                heading: Inspector
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 60
            }
            source {
                databaseColumn: INSPECTOR
                dataType: varchar2
            }
        )

        column INSPECTION_DATE (
            type: datePicker
            heading {
                heading: Inspection Date
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: INSPECTION_DATE
                dataType: date
            }
        )

        column RESULT (
            type: selectList
            heading {
                heading: Result
            }
            layout {
                sequence: 80
            }
            lov {
                type: staticValues
                staticValues: STATIC:Pass;PASS,Fail;FAIL,Conditional;CONDITIONAL
            }
            source {
                databaseColumn: RESULT
                dataType: varchar2
            }
        )

        column DEFECT_CODE (
            type: textField
            heading {
                heading: Defect Code
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: DEFECT_CODE
                dataType: varchar2
            }
        )

        column NOTES (
            type: textField
            heading {
                heading: Notes
            }
            layout {
                sequence: 100
            }
            validation {
                maxLength: 400
            }
            source {
                databaseColumn: NOTES
                dataType: varchar2
            }
        )
    )

    process QUALITY_INSPECTIONS_GRID_ARP (
        name: Quality Inspections - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @QUALITY_INSPECTIONS_GRID
        execution {
            sequence: 10
        }
    )

)
