page 91 (
    name: Outbound Order Form
    alias: OUTBOUND-ORDER-FORM
    title: Outbound Order Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Create or update one outbound order header (FR-04). Customer and Warehouse are selected from their active master lists. Prefer driving STATUS through PKG_OUTBOUND/PKG_PICKING/PKG_PACKING/PKG_SHIPMENT rather than editing it here directly.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Outbound Order Form
        type: form
        source {
            location: localDatabase
            tableName: OUTBOUND_ORDER
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P91_ORDER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: ORDER_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P91_SUCCESS_MESSAGE (
        type: hidden
        layout {
            sequence: 11
            region: @form
            slot: regionBody
        }
    )

    pageItem P91_ORDER_NUMBER (
        type: textField
        label {
            label: Order Number
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 30
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ORDER_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Unique order number, typically from the source e-shop/accounting system.
        }
    )

    pageItem P91_CUSTOMER_ID (
        type: selectList
        label {
            label: Customer
        }
        lov {
            type: sharedComponent
            lov: @customer-active
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: CUSTOMER_ID
            dataType: number
        }
        help {
            helpText: Ship-to customer, selected from the active Customer master list.
        }
    )

    pageItem P91_WAREHOUSE_ID (
        type: selectList
        label {
            label: Warehouse
        }
        lov {
            type: sharedComponent
            lov: @warehouse-active
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: WAREHOUSE_ID
            dataType: number
        }
        help {
            helpText: Fulfilling warehouse, selected from the active Warehouse master list.
        }
    )

    pageItem P91_ORDER_SOURCE (
        type: textField
        label {
            label: Order Source
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @form
            column: ORDER_SOURCE
            dataType: varchar2
        }
        help {
            helpText: Origin of the order, for example MANUAL or ESHOP.
        }
    )

    pageItem P91_ORDER_DATE (
        type: datePicker
        label {
            label: Order Date
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ORDER_DATE
            dataType: date
        }
        help {
            helpText: Date the order was placed.
        }
    )

    pageItem P91_REQUIRED_SHIP_DATE (
        type: datePicker
        label {
            label: Required Ship Date
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: REQUIRED_SHIP_DATE
            dataType: date
        }
        help {
            helpText: Date the customer expects to receive the order.
        }
    )

    pageItem P91_PRIORITY (
        type: textField
        label {
            label: Priority
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @form
            column: PRIORITY
            dataType: varchar2
        }
        help {
            helpText: Optional priority tag, for example NORMAL or RUSH.
        }
    )

    pageItem P91_STATUS (
        type: selectList
        label {
            label: Status
        }
        lov {
            type: staticValues
            staticValues: STATIC:Received;RECEIVED,Allocated;ALLOCATED,Picking;PICKING,Picked;PICKED,Packed;PACKED,Shipped;SHIPPED,Cancelled;CANCELLED
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: RECEIVED
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: STATUS
            dataType: varchar2
        }
        help {
            helpText: Normally advanced automatically by PKG_OUTBOUND/PKG_PICKING/PKG_PACKING/PKG_SHIPMENT; edit here only to correct a mistake.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P91_ORDER_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P91_ORDER_ID
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P91_ORDER_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process initialize-form-form (
        name: Initialize form Form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process set-success-message-form (
        name: Set Success Message
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P91_SUCCESS_MESSAGE :=
                    case :REQUEST
                        when 'CREATE' then 'Outbound order was created successfully.'
                        when 'APPLY-CHANGES' then 'Outbound order was updated successfully.'
                        when 'DELETE' then 'Outbound order was deleted successfully.'
                        else null
                    end;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process process-form-form (
        name: Process form Form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &P91_SUCCESS_MESSAGE.
        }
    )

)
