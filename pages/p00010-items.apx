page 10 (
    name: Items
    alias: ITEMS
    title: Items
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Browse and maintain the item / SKU catalog (FR-01). Use Actions > Add Row to create a new item, edit cells inline, and Save to persist changes. UOM is selected from the active UOM master list.
    }

    region breadcrumb (
        name: Items
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--compactTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region ITEMS_GRID (
        name: Items
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    item_id,
                    item_code,
                    item_name,
                    device_category,
                    uom,
                    barcode_value,
                    is_lot_tracked,
                    reorder_point,
                    is_active
                from item
                order by item_code
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No items found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @ITEM_CODE
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @ITEM_NAME
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @DEVICE_CATEGORY
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @UOM
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @BARCODE_VALUE
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @IS_LOT_TRACKED
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @REORDER_POINT
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @IS_ACTIVE
                layout {
                    sequence: 8
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ITEM_ID (
            type: hidden
            layout {
                sequence: 15
            }
            source {
                databaseColumn: ITEM_ID
                dataType: number
                primaryKey: true
            }
        )

        column ITEM_CODE (
            type: textField
            heading {
                heading: Item Code
            }
            layout {
                sequence: 20
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEM_CODE
                dataType: varchar2
            }
        )

        column ITEM_NAME (
            type: textField
            heading {
                heading: Item Name
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: ITEM_NAME
                dataType: varchar2
            }
        )

        column DEVICE_CATEGORY (
            type: textField
            heading {
                heading: Device Category
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 40
            }
            source {
                databaseColumn: DEVICE_CATEGORY
                dataType: varchar2
            }
        )

        column UOM (
            type: selectList
            heading {
                heading: UOM
            }
            layout {
                sequence: 50
            }
            lov {
                type: sharedComponent
                lov: @uom-active
            }
            source {
                databaseColumn: UOM
                dataType: varchar2
            }
        )

        column BARCODE_VALUE (
            type: textField
            heading {
                heading: Barcode
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 64
            }
            source {
                databaseColumn: BARCODE_VALUE
                dataType: varchar2
            }
        )

        column IS_LOT_TRACKED (
            type: checkbox
            heading {
                heading: Lot Tracked
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: IS_LOT_TRACKED
                dataType: varchar2
            }
        )

        column REORDER_POINT (
            type: numberField
            heading {
                heading: Reorder Point
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                databaseColumn: REORDER_POINT
                dataType: number
            }
        )

        column IS_ACTIVE (
            type: checkbox
            heading {
                heading: Active
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: IS_ACTIVE
                dataType: varchar2
            }
        )
    )

    process ITEMS_GRID_ARP (
        name: Items - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @ITEMS_GRID
        execution {
            sequence: 10
        }
    )

)
