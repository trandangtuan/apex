lov item-active (
    name: ITEM_ACTIVE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select item_code || ' - ' || item_name as display_value,
                   item_id as return_value
              from item
             where is_active = 'Y'
             order by item_code
            ```
    }
    columnMapping {
        return: return_value
        display: display_value
    }
)

lov uom-active (
    name: UOM_ACTIVE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select uom_name || ' (' || uom_code || ')' as display_value,
                   uom_code as return_value
              from uom
             where is_active = 'Y'
             order by uom_name
            ```
    }
    columnMapping {
        return: return_value
        display: display_value
    }
)

