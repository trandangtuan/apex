lov putaway-location-active (
    name: PUTAWAY_LOCATION_ACTIVE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select location_code as display_value,
                   location_id as return_value
              from location
             where is_active = 'Y'
               and location_type in ('PICK_FACE', 'BULK')
             order by location_code
            ```
    }
    columnMapping {
        return: return_value
        display: display_value
    }
)

lov lot-any (
    name: LOT_ANY
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select lt.lot_number || ' (' || i.item_code || ')' as display_value,
                   lt.lot_id as return_value
              from lot lt
              join item i on i.item_id = lt.item_id
             order by lt.lot_number
            ```
    }
    columnMapping {
        return: return_value
        display: display_value
    }
)

lov inbound-receipt-any (
    name: INBOUND_RECEIPT_ANY
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 'Receipt #' || receipt_id || nvl2(po_reference, ' - ' || po_reference, '') as display_value,
                   receipt_id as return_value
              from inbound_receipt
             order by receipt_id desc
            ```
    }
    columnMapping {
        return: return_value
        display: display_value
    }
)

lov outbound-order-any (
    name: OUTBOUND_ORDER_ANY
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select order_number as display_value,
                   order_id as return_value
              from outbound_order
             order by order_id desc
            ```
    }
    columnMapping {
        return: return_value
        display: display_value
    }
)
